# load nvm so node/npm are on PATH when the hook runs from GUI clients (Fork, GitHub Desktop,
# JetBrains) whose env doesn't include nvm's per-version node bin dir.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  # shellcheck disable=SC1091
  . "$NVM_DIR/nvm.sh"
fi

SKIP_LIVE_TESTS=1 npm test
