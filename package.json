{
  "name": "labtech-script-decode",
  "description": "Utilites to decode LabTech scripts and encodings.",
  "keywords": [
    "LabTech",
    "ConnectWise Automate"
  ],
  "author": {
    "name": "Kevin Grube",
    "url": "https://github.com/k-grube"
  },
  "repository": "https://github.com/k-grube/labtech-script-decode.git",
  "homepage": "https://github.com/k-grube/labtech-script-decode",
  "bugs": {
    "url": "https://github.com/k-grube/labtech-script-decode/issues"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.config.umd.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs": "node docs/generate > DOC.md"
  },
  "main": "./dist/labtech-script-decode.cjs",
  "module": "./dist/labtech-script-decode.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/labtech-script-decode.js",
      "require": "./dist/labtech-script-decode.cjs"
    }
  },
  "files": ["dist", "src", "DOC.md"],
  "type": "module",
  "license": "MIT",
  "version": "0.8.0",
  "dependencies": {
    "ajv": "8.20.0",
    "pako": "2.2.0",
    "xml2js": "0.6.2"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "jsdoc": "4.0.4",
    "vite": "7.3.6",
    "vite-plugin-node-polyfills": "0.28.0",
    "vitest": "3.2.7"
  }
}
