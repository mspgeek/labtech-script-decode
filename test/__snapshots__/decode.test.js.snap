              "Param1": "@FILEPATH@",
              "Param2": "",
              "Param3": "",
              "Param4": "",
              "Param5": "",
              "Sort": 32,
              "StepDescription": "Upload: @FILEPATH@ to LTSHARE\\Uploads\\, store the result in %uploadedfile%",
            },
            {
              "Action": 2,
              "ActionObject": "ThenSection",
              "Continue": 0,
              "ContinueObject": "Exit on failure",
              "FunctionId": 19,
              "FunctionObject": {
                "Description": "Download file from external site and save it to a local file.",
                "FunctionFlag": "Computer",
                "FunctionId": 19,
                "FunctionType": "Function",
                "Name": "File Download URL",
                "ParamNames": [
                  {
                    "Description": "URL to the file that is downloaded, urlencode any strange characters.",
                    "ParamName": "URL",
