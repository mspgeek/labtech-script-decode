            {
              "Action": 2,
              "ActionObject": "ThenSection",
              "Continue": 0,
              "ContinueObject": "Exit on failure",
              "FunctionId": 17,
              "FunctionObject": {
                "Description": "Start a new script, all variables are passed to new script. If script fails then step will fail.",
                "FunctionFlag": "Computer",
                "FunctionId": 17,
                "FunctionType": "Function",
                "Name": "Script Run",
                "ParamNames": [
                  {
                    "Description": "Choose script to run.",
                    "ParamName": "Script ID",
                    "Value": "c7a65c93-eadc-11e1-bca6-7ec667b1402e",
                    "Values": [
                      "Select CONVERT(CONCAT(ifnull(CONCAT(f.Name,'\\\\'),''),ifnull(CONCAT(s.Name,'\\\\'),''),c.ScriptName,CHAR(0),c.scriptid) using latin1) FROM LT_scripts c LEFT join scriptfolders s on s.folderid=c.folderid left join scriptfolders f on f.folderid=s.parentid ORDER BY CONCAT((CASE WHEN f.name IS NULL THEN '' ELSE f.name END),s.name,c.ScriptName)",
                    ],
                  },
                  {
                    "Description": "Leave blank or enter zero to run script as procedure, otherwise script will be scheduled to run the number of minutes entered.",
                    "ParamName": "Delay",
                    "Value": "",
                  },
                ],
                "Parameters": 2,
              },
              "Indentation": 0,
              "OsLimit": 0,
              "OsLimitObject": "All Operating Systems",
              "Param1": "c7a65c93-eadc-11e1-bca6-7ec667b1402e",
              "Param2": "@DELAY@",
              "Param3": "",
              "Param4": "",
              "Param5": "",
              "Sort": 30,
              "StepDescription": "Run Script: c7a65c93-eadc-11e1-bca6-7ec667b1402e in Minutes: @DELAY@",
            },
            {
              "Action": 2,
              "ActionObject": "ThenSection",
              "Continue": 0,
              "ContinueObject": "Exit on failure",
              "FunctionId": 17,
              "FunctionObject": {
                "Description": "Start a new script, all variables are passed to new script. If script fails then step will fail.",
                "FunctionFlag": "Computer",
                "FunctionId": 17,
                "FunctionType": "Function",
                "Name": "Script Run",
                "ParamNames": [
                  {
                    "Description": "Choose script to run.",
                    "ParamName": "Script ID",
                    "Value": "c7a65c93-eadc-11e1-bca6-7ec667b1402e",
                    "Values": [
                      "Select CONVERT(CONCAT(ifnull(CONCAT(f.Name,'\\\\'),''),ifnull(CONCAT(s.Name,'\\\\'),''),c.ScriptName,CHAR(0),c.scriptid) using latin1) FROM LT_scripts c LEFT join scriptfolders s on s.folderid=c.folderid left join scriptfolders f on f.folderid=s.parentid ORDER BY CONCAT((CASE WHEN f.name IS NULL THEN '' ELSE f.name END),s.name,c.ScriptName)",
                    ],
                  },
                  {
                    "Description": "Leave blank or enter zero to run script as procedure, otherwise script will be scheduled to run the number of minutes entered.",
                    "ParamName": "Delay",
                    "Value": "",
                  },
                ],
                "Parameters": 2,
              },
              "Indentation": 0,
              "OsLimit": 0,
              "OsLimitObject": "All Operating Systems",
              "Param1": "c7a65c93-eadc-11e1-bca6-7ec667b1402e",
              "Param2": "",
              "Param3": "",
              "Param4": "",
              "Param5": "",
              "Sort": 31,
              "StepDescription": "Run Script: c7a65c93-eadc-11e1-bca6-7ec667b1402e",
            },
            {
              "Action": 2,
              "ActionObject": "ThenSection",
              "Continue": 0,
              "ContinueObject": "Exit on failure",
              "FunctionId": 18,
              "FunctionObject": {
                "Description": "Send file from the remote computer to your LabTech server and save it in LTShare\\Uploads. Returns %uploadedfile% with the local path to the file.",
                "FunctionFlag": "Computer",
                "FunctionId": 18,
                "FunctionType": "Function",
                "Name": "File Upload",
                "ParamNames": [
                  {
                    "Description": "Full path to the file to send.",
                    "ParamName": "File Path",
                    "Value": "@FILEPATH@",
                  },
                ],
                "Parameters": 1,
              },
