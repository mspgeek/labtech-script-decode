                "FunctionFlag": "Global",
                "FunctionId": 117,
                "FunctionType": "Function",
                "Name": "IF SQL Data Check",
                "ParamNames": [
                  {
                    "Description": "Statement must return 1 value.",
                    "ParamName": "Sql Statement",
                    "Value": "@SQLSTATEMENT@",
                  },
                  {
                    "Description": "Logical Operator.",
                    "ParamName": "Compare",
                    "Value": 0,
                    "Values": [
                      "Exists",
                      "Not Exists",
                      "=",
                      "Not =",
                      "<",
                      "<=",
                      ">",
                      ">=",
                      "Contains",
                      "Not Contains",
                    ],
                  },
                  {
                    "Description": "Value to compare.",
                    "ParamName": "To",
                    "Value": "",
