              "Continue": 0,
              "ContinueObject": "Exit on failure",
              "FunctionId": 134,
              "FunctionObject": {
                "Description": "Add Time to Ticket as User.",
                "FunctionFlag": "Global",
                "FunctionId": 134,
                "FunctionType": "Function",
                "Name": "Ticket Add Time",
                "ParamNames": [
                  {
                    "Description": "Ticket to add time to.",
                    "ParamName": "Ticket ID",
                    "Value": "@TICKETID@",
                  },
                  {
                    "Description": "ID Number of the user to perform the Comment or type a Variable name",
                    "ParamName": "User ID",
                    "Value": 1,
                    "Values": [
                      "Select convert(CONCAT(Name,CHAR(0),UserID) using UTF8) from users Order By Name",
                    ],
                  },
                  {
                    "Description": "The Message to include as the Body.",
                    "ParamName": "Body",
                    "Value": "@BODY@",
                  },
                  {
                    "Description": "Number of Minutes to Add.",
                    "ParamName": "Time",
                    "Value": "@TIME@",
                  },
                  {
                    "Description": "ID Number of the Time Category to add.",
                    "ParamName": "Time Category ID",
                    "Value": "@CATEGORYID@",
                  },
                ],
                "Parameters": 5,
              },
              "Indentation": 0,
              "OsLimit": 0,
              "OsLimitObject": "All Operating Systems",
              "Param1": "@TICKETID@",
              "Param2": 1,
              "Param3": "@BODY@",
              "Param4": "@TIME@",
              "Param5": "@CATEGORYID@",
              "Sort": 198,
              "StepDescription": "Add @TIME@ Minutes to Ticket #@TICKETID@",
            },
